# 仅供本地 wrangler dev 使用。复制为 .dev.vars 后填写真实值。
# .dev.vars 已被 .gitignore 排除，严禁提交真实密钥。

GATEWAY_ACCESS_KEY="replace-with-a-long-random-key"

# ============ Node Scheduler 配置（必需） ============
# 节点池定义（JSON 数组）。models 为 逻辑模型名 -> 实际上游模型名 的映射。
NODES_CONFIG='[{"id":"free-node-01","tier":"free","priority":100,"provider":"provider-a","secret_ref":"FREE_NODE_01","workloads":["general","coding"],"capabilities":["chat","stream","tools"],"models":{"general-air":"free-model-air","code-pro":"free-model-pro"},"limits":{"concurrency":2}}]'

# 为每个节点的 secret_ref 添加凭据（Token@BaseURL 格式，默认仅 HTTPS）。
FREE_NODE_01="token@https://free-api.example/v1"

# 可选：逻辑模型映射与策略。
# MODELS_CONFIG='{"general-air":{"workload":"general","policy":"general-fast"},"code-pro":{"workload":"coding","policy":"coding-stable"}}'
# POLICIES_CONFIG='{"general-fast":{"tiers":["free","paid"],"max_attempts":3,"retry_budget":{"free":2,"paid":1}},"coding-stable":{"tiers":["free","paid","plus"],"max_attempts":4,"retry_budget":{"free":2,"paid":1,"plus":1}}}'

# 默认安全策略。
ALLOW_UNSAFE_PROXY_ROUTES="false"
ALLOW_INSECURE_HTTP_UPSTREAM="false"
EXPOSE_UPSTREAM_INFO="false"
FAKE_STREAM_PROTECTION="false"

# 超时拆分。
UPSTREAM_HEADERS_TIMEOUT="30000"
FIRST_EVENT_TIMEOUT="60000"
STREAM_IDLE_TIMEOUT="120000"

# 其他。
MODEL_LIST_TIMEOUT_MS="5000"
LOG_LEVEL="info"