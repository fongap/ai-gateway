# 仅供本地 wrangler dev 使用。复制为 .dev.vars 后填写真实值。
# .dev.vars 已被 .gitignore 排除，严禁提交真实密钥。

GATEWAY_ACCESS_KEY="replace-with-a-long-random-key"

# ============ Node Scheduler 配置（必需） ============
# 按优先级顺序配置，tier-1 优先、tier-2、tier-3。
# 每层为一个 JSON 数组。节点中的 tier 字段由配置文件隐含。

# tier-1 层节点（默认优先）
TIER1_NODES_CONFIG='[{"id":"tier-1-node-01","secret_ref":"TIER1_NODE_01","models":{"general-air":"free-model-air"}}]'

# tier-2 层节点（可选）
# TIER2_NODES_CONFIG='[{"id":"tier-2-node-01","secret_ref":"TIER2_NODE_01","models":{"code-pro":"paid-model-pro"}}]'

# tier-3 层节点（可选）
# TIER3_NODES_CONFIG='[{"id":"tier-3-node-01","secret_ref":"TIER3_NODE_01","models":{"code-max":"plus-model-max"}}]'

# 各节点的凭据（Token@BaseURL 格式，默认仅 HTTPS）。
TIER1_NODE_01="token@https://tier-1-api.example/v1"
# TIER2_NODE_01="token@https://tier-2-api.example/v1"
# TIER3_NODE_01="token@https://tier-3-api.example/v1"

# 可选：逻辑模型映射与策略。
# MODELS_CONFIG='{"general-air":{"workload":"general","policy":"general-fast"}}'
# POLICIES_CONFIG='{"general-fast":{"tiers":["free","paid"],"max_attempts":3,"retry_budget":{"free":2,"paid":1}}}'

# 默认安全策略。
ALLOW_UNSAFE_PROXY_ROUTES="false"
ALLOW_INSECURE_HTTP_UPSTREAM="false"
EXPOSE_UPSTREAM_INFO="false"
FAKE_STREAM_PROTECTION="false"

# 超时拆分。
UPSTREAM_HEADERS_TIMEOUT="30000"
FIRST_EVENT_TIMEOUT="60000"
STREAM_IDLE_TIMEOUT="120000"

# 其他。
MODEL_LIST_TIMEOUT_MS="5000"
LOG_LEVEL="info"