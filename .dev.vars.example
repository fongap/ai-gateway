# 仅供本地 wrangler dev 使用。复制为 .dev.vars 后填写真实值。
# .dev.vars 已被 .gitignore 排除，严禁提交真实密钥。

GATEWAY_ACCESS_KEY="replace-with-a-long-random-key"
PRIMARY_API_TOKENS="token-a@https://primary-a.example/v1,token-b@https://primary-b.example/v1"

# Token 未绑定 URL 时使用共享 HTTPS Base URL。
# PRIMARY_BASE_URL="https://primary.example/v1"

# 可选：模型别名映射。
# MODEL_MAPPING='{"primary-a.example":{"model-alias":"vendor/model-id"}}'
# STRICT_MODEL_MAPPING="true"

# 默认安全策略。
ALLOW_UNSAFE_PROXY_ROUTES="false"
ALLOW_INSECURE_HTTP_UPSTREAM="false"
EXPOSE_UPSTREAM_INFO="false"
FAKE_STREAM_PROTECTION="false"

# 模型列表独立超时与尝试次数。
MODEL_LIST_TIMEOUT_MS="5000"
MODEL_LIST_MAX_ATTEMPTS="3"

# 可选：Fallback。关闭时建议显式配置。
FALLBACK_ENABLED="false"
FALLBACK_SECONDARY_MODEL="off"
# FALLBACK_API_TOKEN="replace-with-fallback-token"
# FALLBACK_BASE_URL="https://fallback.example/v1"
# FALLBACK_PRIMARY_MODEL="model-pro"
# FALLBACK_SECONDARY_MODEL="model-flash"
# FALLBACK_CLIENT_NOTICE_MODE="headers"
