# Local development only (wrangler dev). Copy to .dev.vars and fill in real values.
# .dev.vars is gitignored; never commit real credentials.

GATEWAY_ACCESS_KEY="replace-with-a-long-random-key"

# ============ Node configs: plain variables, NO credentials allowed ============
# Tier comes from the variable prefix. Shard values are JSON arrays; each shard
# stays under the 5 KB Cloudflare variable limit (split at node boundaries).

TIER1_NODES_CONFIG_01='[
  {"id":"nvidia-01","provider":"nvidia","protocol":"openai","surfaces":["chat_completions"],"base_url":"https://integrate.api.nvidia.com/v1","priority":10,"models":{"general-air":"deepseek-ai/deepseek-v3.1","code-pro":"qwen/qwen3-coder-480b"},"limits":{"concurrency":3,"rpm":40}},
  {"id":"nvidia-02","provider":"nvidia","protocol":"openai","surfaces":["chat_completions"],"base_url":"https://integrate.api.nvidia.com/v1","priority":10,"models":{"general-air":"deepseek-ai/deepseek-v3.1"},"limits":{"concurrency":3,"rpm":40}},
  {"id":"glm-01","provider":"zhipu","protocol":"openai","surfaces":["chat_completions"],"base_url":"https://open.bigmodel.cn/api/paas/v4","priority":20,"models":{"code-max":"glm-4.7"},"limits":{"concurrency":2}}
]'
# Same tier + same priority = LRU rotation; different priority = strict order.
# NODE_SECRETS_01='{"nvidia-01":"nvapi-xxx","nvidia-02":"nvapi-yyy","glm-01":"zzz.id"}'
# TIER2_NODES_CONFIG_01='[{"id":"fallback-01","base_url":"https://fallback.example.com/v1","models":{"general-air":"fa"}}]'
# TIER3_NODES_CONFIG_01='[{"id":"last-resort-01","base_url":"https://last.example.com/v1","models":{}}]'

# ============ Credentials live ONLY here (Secrets) ============
# NODE_SECRETS_01='{"nvidia-01":"nvapi-xxx","openrouter-01":"sk-or-xxx"}'
# More shards: NODE_SECRETS_02, NODE_SECRETS_03, ...

# ============ Optional policy / model config ============
# MODELS_CONFIG='{"general-air":{"policy":"fast"}}'
# POLICIES_CONFIG='{"fast":{"max_attempts":5}}'

# ============ Runtime knobs (all optional) ============
# The full list and defaults live in src/config/runtime-vars.js (single source
# of truth). The GitHub deployment bridge and deploy.yml inject every name
# listed there; local dev can override any of them in this file.
# DEFAULT VALUES (from runtime-vars.js) ARE SHOWN IN COMMENTS — DO NOT UNCOMMENT
# UNLESS YOU INTENTIONALLY WANT TO OVERRIDE THE CODE DEFAULTS.
# MAX_BODY_BYTES="20971520"              # default: 20971520 (20 MB)
# UPSTREAM_HEADERS_TIMEOUT_MS="15000"     # default: 15000 (15 s)
# FIRST_EVENT_TIMEOUT_MS="30000"          # default: 30000 (30 s)
# STREAM_IDLE_TIMEOUT_MS="120000"         # default: 120000 (120 s)
# RATE_LIMIT_COOLDOWN_MS="30000"          # default: 30000 (30 s)
# AUTH_FAIL_COOLDOWN_MS="3600000"         # default: 3600000 (1 h)
# FAILOVER_BUDGET_MS="60000"              # default: 60000 (60 s)
# HEDGE_DELAY_MS="3000"                   # default: 3000 (3 s)
# MAX_HEDGES_PER_REQUEST="1"              # default: 1
# LOG_LEVEL="info"                        # default: info
# EXPOSE_UPSTREAM_INFO="false"            # default: false
# FAKE_STREAM_PROTECTION="false"          # default: false
# ALLOW_INSECURE_HTTP_UPSTREAM="false"    # default: false
# ANTHROPIC_COUNT_TOKENS_MODE="approximate" # default: approximate

# ============ Protocol Fallback (optional) ============
# JSON object mapping client route to ordered fallback chains.
# Only "anthropic:messages" -> ["openai:chat_completions"] is supported.
# PROTOCOL_FALLBACKS='{"anthropic:messages":["openai:chat_completions"]}'

# ============ Token-usage stream hint (all optional, fail-open) ============
# Ask OpenAI-compatible streaming upstreams to report usage in the final chunk
# via stream_options.include_usage. "auto" (default) uses each node's provider
# protocol and provider quirks; "on" forces it; "off" disables it everywhere.
# Off never breaks any request — an upstream that rejects the field just means
# that provider's streaming usage counts as missing (never estimated).
# STREAM_INCLUDE_USAGE="auto"
# Comma-separated provider labels to disable the streaming usage hint for:
# STREAM_USAGE_INCLUDE_OFF_PROVIDERS="my-llm-provider"

# CORS is DISABLED by default. Set an explicit origin to enable browser access:
# ALLOWED_ORIGIN="https://your-app.example.com"
