# Local development only (wrangler dev). Copy to .dev.vars and fill in real values.
# .dev.vars is gitignored; never commit real credentials.

GATEWAY_ACCESS_KEY="replace-with-a-long-random-key"

# ============ Node configs: plain variables, NO credentials allowed ============
# Tier comes from the variable prefix. Shard values are JSON arrays; each shard
# stays under the 5 KB Cloudflare variable limit (split at node boundaries).

TIER1_NODES_CONFIG_01='[
  {"id":"nvidia-01","provider":"nvidia","base_url":"https://integrate.api.nvidia.com/v1","priority":10,"models":{"general-air":"deepseek-ai/deepseek-v3.1","code-pro":"qwen/qwen3-coder-480b"},"limits":{"concurrency":3,"rpm":40}},
  {"id":"nvidia-02","provider":"nvidia","base_url":"https://integrate.api.nvidia.com/v1","priority":10,"models":{"general-air":"deepseek-ai/deepseek-v3.1"},"limits":{"concurrency":3,"rpm":40}},
  {"id":"glm-01","provider":"zhipu","base_url":"https://open.bigmodel.cn/api/paas/v4","priority":20,"models":{"code-max":"glm-4.7"},"limits":{"concurrency":2}}
]'
# 同层同 priority = LRU 轮转摊流；不同 priority = 严格先后。
# NODE_SECRETS_01='{"nvidia-01":"nvapi-xxx","nvidia-02":"nvapi-yyy","glm-01":"zzz.id"}'
# TIER2_NODES_CONFIG_01='[{"id":"fallback-01","base_url":"https://fallback.example.com/v1","models":{"general-air":"fa"}}]'
# TIER3_NODES_CONFIG_01='[{"id":"last-resort-01","base_url":"https://last.example.com/v1","models":{}}]'

# ============ Credentials live ONLY here (Secrets) ============
# NODE_SECRETS_01='{"nvidia-01":"nvapi-xxx","openrouter-01":"sk-or-xxx"}'
# More shards: NODE_SECRETS_02, NODE_SECRETS_03, ...

# ============ Optional policy / model config ============
# MODELS_CONFIG='{"general-air":{"policy":"fast"}}'
# POLICIES_CONFIG='{"fast":{"max_attempts":5}}'

# ============ Runtime knobs (all optional) ============
MAX_BODY_BYTES="20971520"
UPSTREAM_HEADERS_TIMEOUT_MS="120000"
FIRST_EVENT_TIMEOUT_MS="60000"
STREAM_IDLE_TIMEOUT_MS="90000"
RATE_LIMIT_COOLDOWN_MS="60000"
AUTH_FAIL_COOLDOWN_MS="3600000"
LOG_LEVEL="info"
EXPOSE_UPSTREAM_INFO="false"
FAKE_STREAM_PROTECTION="false"
ALLOW_INSECURE_HTTP_UPSTREAM="false"
ANTHROPIC_COUNT_TOKENS_MODE="approximate"
ANTHROPIC_REASONING_REQUEST_MODE="none"

# ============ Token-usage stream hint (all optional, fail-open) ============
# Ask OpenAI-compatible streaming upstreams to report usage in the final chunk
# via stream_options.include_usage. "auto" (default) uses each node's provider
# profile capability; "on" forces it; "off" disables it everywhere. Off never
# breaks any request — an upstream that rejects the field just means that
# provider's streaming usage counts as missing (never estimated).
# STREAM_INCLUDE_USAGE="auto"
# Comma-separated provider labels to disable the streaming usage hint for:
# STREAM_USAGE_INCLUDE_OFF_PROVIDERS="my-llm-provider"

# CORS is DISABLED by default. Set an explicit origin to enable browser access:
# ALLOWED_ORIGIN="https://your-app.example.com"
